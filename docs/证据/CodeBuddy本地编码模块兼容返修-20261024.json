  "contractTable": [
    {
      "command": "git.exe (check-ignore/ls-files)",
      "outputChannel": "C 运行时输出；core.quotepath 下路径为 ASCII 转义",
      "encoding": "ASCII（>=0x80 字节一律拒绝）",
      "strictDecode": "字节级校验",
      "rationale": "Git 协议路径经 quotepath 转义为纯 ASCII；非 ASCII 字节出现即形状异常"
    },
    {
      "command": "whoami.exe /user /fo csv /nh",
      "outputChannel": "原生命令管道输出",
      "encoding": "OEM CP 936（GB18030 兼容）",
      "strictDecode": "TextDecoder(\"gb18030\",{fatal:true})",
      "rationale": "与 icacls 同为原生命令、同一 C 运行时输出通道；当前输出 ASCII 部分双编码等价，不单独作证明"
    },
    {
      "command": "icacls.exe <路径>",
      "outputChannel": "原生命令管道输出",
      "encoding": "OEM CP 936（GB18030 兼容）",
      "strictDecode": "TextDecoder(\"gb18030\",{fatal:true})",
      "rationale": "UTF-8 严格解码失败（历史替换字符证据 + 本轮 S3 严格失败），GB18030 严格解码成功且中文统计行语义锚定"
    },
    {
      "command": "powershell.exe PROTECT/UNPROTECT",
      "outputChannel": "受控 PS 会话 stdout/命名管道",
      "encoding": "stdout=ASCII hex 密文；管道=UTF-8 明文 JSON",
      "strictDecode": "stdout 字节级校验 hex；管道 Buffer→UTF-8 严格解码",
      "rationale": "ConvertFrom-SecureString 输出为 hex 字符串；管道明文由本包 Node 端 UTF-8 JSON 解析（现行契约不变）"
    }
  ],
  "strictDecodeCapability": {
    "runtime": "Node v22.22.2",
    "decoders": [
      "utf-8(fatal)",
      "gb18030(fatal)"
    ],
    "verified": "合成字节双向验证：GBK 字节被 UTF-8 fatal 拒绝、被 GB18030 fatal 解码为语义中文；非法/不完整 GB18030 序列被拒绝（详见 results.S4 之外的本探针实现内建验证）"
  },
  "onlyReadFacts": {
    "identityRead": true,
    "identityInMemoryOnly": true,
    "aclRead": true,
    "aclTarget": "artifacts/schedule-sandbox/.participant-private",
    "aclInMemoryOnly": true,
    "dpapiRun": false,
    "ps1UiRun": false,
    "privateFileSaved": false,
    "aclModified": false,
    "directoriesListed": false
  },
  "unverified": [
    "GB18030 契约仅对本机当前代码页 936 成立；其他机器代码页不同时不适用（每机须重新取证）",
    "icacls 输出编码可能随 Windows 版本/区域设置变化；C1 实现按契约严格解码，任何不确定即拒绝",
    "真实 DPAPI、PS1 UI、真实私密输入未运行（本轮禁止）"
  ],
  "guardAccounting": {
    "note": "本探针为独立一次性脚本，不经 psr-guard-runner；固定只读命令计数见 S5"
