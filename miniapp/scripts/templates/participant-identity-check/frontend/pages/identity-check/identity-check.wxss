.wrap { padding: 32rpx; }
.card { background: #ffffff; border-radius: 16rpx; padding: 32rpx; margin-bottom: 24rpx; }
.title { font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; }
.desc { font-size: 26rpx; color: #5a6b7c; line-height: 40rpx; margin-bottom: 24rpx; }
.label { font-size: 26rpx; margin-bottom: 12rpx; }
.pass { border: 1rpx solid #c8d4e0; border-radius: 10rpx; padding: 20rpx; margin-bottom: 12rpx; }
.btn { background: #2f6bff; color: #ffffff; border-radius: 12rpx; margin-top: 24rpx; }
.tip { font-size: 24rpx; color: #7a8896; line-height: 36rpx; margin-top: 12rpx; }
.row { font-size: 28rpx; line-height: 44rpx; }
.checkline { font-size: 26rpx; color: #5a6b7c; line-height: 40rpx; }
.stop { margin-top: 20rpx; font-size: 26rpx; color: #b45309; line-height: 38rpx; }
.buildid { font-size: 26rpx; color: #33475b; word-break: break-all; line-height: 40rpx; margin-bottom: 12rpx; }
