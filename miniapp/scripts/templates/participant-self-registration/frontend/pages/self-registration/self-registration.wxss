.page { padding: 24rpx; }
.warning { background: #fff7e6; border: 1rpx solid #ffd591; padding: 16rpx; border-radius: 8rpx; color: #874d00; font-size: 26rpx; margin-bottom: 24rpx; }
.meta { margin-bottom: 24rpx; }
.row { display: flex; padding: 8rpx 0; }
.label { width: 220rpx; color: #666; font-size: 26rpx; }
.value { flex: 1; word-break: break-all; font-size: 26rpx; }
.field { margin-bottom: 24rpx; }
.field input { border: 1rpx solid #d9d9d9; border-radius: 8rpx; padding: 16rpx; }
.register { background: #1677ff; color: #fff; }
.hint { margin-top: 24rpx; color: #874d00; font-size: 26rpx; }
.result { margin-top: 24rpx; }
