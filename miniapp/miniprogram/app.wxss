page {
  background: #f4f7fb;
  color: #182a45;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.page { padding: 28rpx 28rpx 64rpx; }
.card { padding: 28rpx; background: #fff; border-radius: 20rpx; margin-bottom: 24rpx; border: 1rpx solid #e7edf5; }
.title { font-size: 38rpx; font-weight: 600; line-height: 1.35; }
.subtitle { font-size: 32rpx; font-weight: 600; }
.muted { color: #68788e; }
.small { font-size: 24rpx; }
.section { margin-top: 28rpx; }
.gap { margin-top: 16rpx; }
.row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; }
.notice { border-radius: 16rpx; padding: 20rpx 24rpx; background: #edf3ff; color: #2f527f; font-size: 24rpx; margin-bottom: 24rpx; }
.notice.warning { background: #fff5df; color: #79561f; }
.badge { display: inline-block; background: #eaf1ff; color: #245bd0; border-radius: 8rpx; padding: 4rpx 12rpx; font-size: 24rpx; }
.badge.success { color: #1c7050; background: #e7f5ee; }
.badge.warning { color: #986014; background: #fff1d9; }
.badge.muted { color: #64748b; background: #f0f3f7; }
.label { display: block; font-weight: 500; margin: 24rpx 0 12rpx; }
.field { background: #f7f9fc; border: 1rpx solid #dce4f0; padding: 20rpx; border-radius: 12rpx; min-height: 46rpx; }
input.field { height: 50rpx; }
textarea.field { width: 100%; min-height: 150rpx; box-sizing: border-box; }
.readonly { background: #f7f9fc; border-radius: 12rpx; padding: 20rpx; }
.prewrap { white-space: pre-wrap; word-break: break-all; }
button { font-size: 28rpx; border-radius: 14rpx; margin: 16rpx 0 0; line-height: 1.5; padding: 22rpx 20rpx; background: #edf3ff; color: #245bc7; }
button::after { border: none; }
button.primary { background: #2563db; color: #fff; }
button.secondary { background: #fff; border: 1rpx solid #cddbf2; color: #245bc7; }
button.link { padding: 8rpx 0; background: transparent; font-size: 24rpx; text-align: left; }
button[disabled] { color: #96a2b2; background: #e8edf4; }
.actions { display: flex; flex-wrap: wrap; gap: 16rpx; }
.actions button { flex: 1; min-width: 180rpx; }
.tabs { display: flex; gap: 12rpx; margin: 24rpx 0; }
.tabs button { flex: 1; margin: 0; padding: 18rpx 4rpx; font-size: 26rpx; }
.tabs .active { background: #2563db; color: #fff; }
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip { margin: 0; font-size: 24rpx; padding: 14rpx 20rpx; border: 1rpx solid #dde5f1; background: #f8faff; color: #526479; }
.chip.selected { background: #e8f0ff; border-color: #2563db; color: #245bc7; }
.empty { text-align: center; padding: 48rpx 16rpx; color: #68788e; }
.divider { border-top: 1rpx solid #e9edf3; margin: 24rpx 0; }
.error { color: #a44324; background: #fff2ed; padding: 20rpx; border-radius: 12rpx; }
.media-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.media-item { width: calc((100% - 24rpx) / 3); }
.media-image, .media-placeholder { width: 100%; height: 172rpx; border-radius: 12rpx; background: #edf2f9; }
.media-placeholder { display: flex; flex-direction: column; justify-content: center; align-items: center; color: #61738d; font-size: 24rpx; text-align: center; }
.media-time { font-size: 20rpx; color: #718097; word-break: break-all; }
.video { width: 100%; height: 350rpx; border-radius: 12rpx; margin-top: 16rpx; }
