<view class="page">
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <block wx:if="{{project}}">
    <view class="notice">本地试用 · {{account.name}}<view>仅保存虚构说明和测试影像，不会发送给真实成员。</view></view>
    <view class="title">{{project.name}}</view><view class="muted gap">今日现场记录 · {{today}}</view>
    <view class="card section">
      <view class="label">施工安排 / 工种（自动带入）</view>
      <picker wx:if="{{options.length > 1}}" range="{{options}}" range-key="label" value="{{optionIndex}}" disabled="{{saving || capturing}}" bindchange="changePlan"><view class="field">{{schedule.trade}} · {{schedule.stage}} ▾</view></picker>
      <view wx:else class="readonly">{{schedule.trade}} · {{schedule.stage}}</view>
      <view class="label">本次施工内容</view><view class="readonly prewrap">{{schedule.content}}</view>
      <view class="label">预计完成日期</view><view class="readonly">{{schedule.expected}}</view><view class="small muted gap">以上由管家维护，发布时保留当前安排。</view>
      <view class="label">施工位置</view><view class="chips"><button wx:for="{{spaces}}" wx:key="name" class="chip {{item.selected ? 'selected' : ''}}" data-name="{{item.name}}" disabled="{{saving}}" bindtap="toggleSpace">{{item.name}}</button></view>
      <input class="field gap" maxlength="120" value="{{location}}" disabled="{{saving}}" placeholder="快捷多选后，也可自由补充位置" bindinput="inputLocation" />
      <view class="label">现场施工说明</view><textarea class="field" maxlength="1000" value="{{note}}" disabled="{{saving}}" placeholder="填写今天做了什么、现场进展如何" bindinput="inputNote" />
    </view>
    <view class="card">
      <view class="subtitle">现场影像</view><view class="small muted gap">至少 3 张照片或 1 段视频；最多 9 张照片，每段视频不超过 60 秒。</view>
      <picker range="{{modes}}" value="{{modeIndex}}" disabled="{{saving || capturing}}" bindchange="changeMode"><view class="field gap">{{modes[modeIndex]}} ▾</view></picker>
      <view class="notice warning gap">{{modeIndex === 0 ? '模拟影像只演示数量和发布流程，无真实照片或视频文件。' : '相机接口仅请求现场拍摄，设备能力尚待真机核验。时间仅为本机记录；照片水印尚未烧录，云端压缩及来源校验尚未接入。'}}</view>
      <view class="actions"><button class="secondary" data-type="image" disabled="{{saving || capturing || images.length >= 9}}" bindtap="capture">{{modeIndex === 0 ? '模拟拍摄 1 张照片' : '拍摄照片'}}</button><button class="secondary" data-type="video" disabled="{{saving || capturing}}" bindtap="capture">{{modeIndex === 0 ? '模拟录制 15 秒视频' : '录制视频'}}</button></view>
      <view class="gap">已选 {{images.length}} 张照片、{{videos.length}} 段视频</view><view class="small muted">{{mediaHint}}</view>
      <view class="media-grid"><view wx:for="{{images}}" wx:key="id" class="media-item"><view wx:if="{{item.source === 'simulated'}}" class="media-placeholder">模拟照片<view>非现场影像</view></view><image wx:else class="media-image" src="{{item.path}}" mode="aspectFill" data-path="{{item.path}}" bindtap="previewImage" /><view class="media-time">{{item.capturedAt}}</view><button class="link" data-id="{{item.id}}" disabled="{{saving || capturing}}" bindtap="removeMedia">移除</button></view></view>
      <view wx:for="{{videos}}" wx:key="id" class="gap"><view wx:if="{{item.source === 'simulated'}}" class="readonly">模拟视频 · {{item.duration}} 秒（无视频文件）</view><video wx:else class="video" src="{{item.path}}" controls /><view class="media-time">{{item.capturedAt}} · {{item.duration}} 秒</view><button class="link" data-id="{{item.id}}" disabled="{{saving || capturing}}" bindtap="removeMedia">移除视频</button></view>
    </view>
    <view wx:if="{{submitError}}" class="error">{{submitError}}</view><view wx:if="{{saving}}" class="small muted gap">{{saveProgress}}</view>
    <button class="primary" loading="{{saving}}" disabled="{{saving || capturing}}" bindtap="submit">{{submitError ? '重试发布到本机' : '发布到本机示例项目'}}</button>
    <view class="small muted gap">保存成功后，同项目示例成员可立即查看。发布后不能直接删除或覆盖；此版本尚未接入更正流程。离开前请完成发布，未发布草稿不会跨页面保留。</view>
  </block>
</view>
