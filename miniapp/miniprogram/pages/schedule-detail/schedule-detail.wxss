.page { padding: 24rpx; }
.error { color: #d93025; background: #fce8e8; padding: 20rpx; border-radius: 8rpx; margin-bottom: 24rpx; }
.title { font-size: 40rpx; font-weight: 600; }
.muted { color: #6b7280; font-size: 28rpx; }
.gap { margin-top: 16rpx; }
.card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-top: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.row { display: flex; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid #f3f4f6; }
.label { color: #6b7280; }
.value { color: #111827; text-align: right; max-width: 60%; }
.cancelled { color: #d93025; }
.prewrap { white-space: pre-wrap; word-break: break-word; margin-top: 16rpx; line-height: 1.6; }
.actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.actions button { flex: 1; }
.secondary { background: #f3f4f6; color: #374151; }
.danger { background: #fee2e2; color: #991b1b; }
.section { margin-top: 32rpx; }
.subtitle { font-size: 32rpx; font-weight: 600; margin-bottom: 12rpx; }
.small { font-size: 24rpx; }
