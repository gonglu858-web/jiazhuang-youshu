.page {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
}

.card {
  padding: 48rpx 36rpx;
  background: #ffffff;
  border-radius: 24rpx;
}

.badge {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
  color: #245dd8;
  background: #eaf1ff;
  font-size: 24rpx;
}

.title {
  margin-top: 36rpx;
  font-size: 40rpx;
  font-weight: 600;
}

.description {
  margin-top: 20rpx;
  color: #65748b;
  font-size: 28rpx;
  line-height: 1.7;
}
