@echo off
set "RENOVATION_DIR=%~dp0"
powershell -NoProfile -Command "$nodePath=Join-Path $env:USERPROFILE '.cache\codex-runtimes\codex-primary-runtime\dependencies\node\bin\node.exe'; $root=$env:RENOVATION_DIR; $url='http://127.0.0.1:4173'; $ready=$false; try { $r=Invoke-WebRequest -Uri $url -UseBasicParsing -TimeoutSec 2; $ready=($r.StatusCode -eq 200 -and $r.Content.Contains('renovation-prototype')) } catch {}; if (!$ready) { if (!(Test-Path -LiteralPath $nodePath)) { Write-Host 'Node runtime missing. Please ask Codex to start this prototype.'; Read-Host 'Press Enter'; exit 1 }; Start-Process -FilePath $nodePath -ArgumentList 'server.mjs' -WorkingDirectory $root -WindowStyle Hidden; Start-Sleep -Seconds 1 }; try { $r=Invoke-WebRequest -Uri $url -UseBasicParsing -TimeoutSec 3; if (!$r.Content.Contains('renovation-prototype')) { throw 'Port in use' }; Start-Process $url } catch { Write-Host 'Prototype could not start. Please ask Codex to check port 4173.'; Read-Host 'Press Enter' }"
